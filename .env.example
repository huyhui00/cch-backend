# คัดลอกเป็น .env แล้วแก้ค่าให้ตรงกับเครื่อง — ห้าม commit .env

# ---- Application -----------------------------------------------------------
NODE_ENV=development
PORT=3000
# คั่นหลาย origin ด้วย comma
FRONTEND_URL=http://localhost:4200
REQUEST_LOG=true
# SWAGGER_ENABLED=false
# THROTTLE_ENABLED=false
# ตั้งเฉพาะเมื่ออยู่หลัง proxy จริง (Cloudflare / nginx) — ห้ามตั้งเมื่อเปิดตรง
# TRUST_PROXY=1

# ---- Database (MySQL 8) ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=cch_db
DB_TIMEZONE=+07:00
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_LOGGING=false

# ---- JWT -------------------------------------------------------------------
# สร้าง secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- Seed ------------------------------------------------------------------
SUPER_ADMIN_USERNAME=superadmin
# บังคับกรอก อย่างน้อย 12 ตัวอักษร
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_FULL_NAME=ผู้ดูแลระบบ
# รหัสของบัญชีเดโม (ไม่ใช้กับ SUPER_ADMIN) — ไม่ตั้ง = Demo@1234
# DEMO_USER_PASSWORD=

# ---- File storage ----------------------------------------------------------
# r2 | local | เว้นว่าง = เลือกเองตาม key ของ R2
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=uploads

# ---- Cloudflare R2 ---------------------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto

# ---- LINE Messaging API ----------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=

# ---- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
# NOTIFY_START_TIME=08:30
# NOTIFY_END_TIME=18:00
# NOTIFY_WEEKENDS=false

# ---- Business config -------------------------------------------------------
# CONTRACT_ANNIVERSARY | CALENDAR_MONTH
MA_QUOTA_RESET_MODE=CONTRACT_ANNIVERSARY
