# ============================================================================
# Internal Management System — Backend
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#   cp .env.example .env
# ห้าม commit ไฟล์ .env เข้า git
# ============================================================================

# ---- Application -----------------------------------------------------------
NODE_ENV=development
PORT=3000

# URL ของ Angular frontend — CORS จะอนุญาตเฉพาะ origin ที่ระบุตรงนี้เท่านั้น
# ใส่หลายค่าได้โดยคั่นด้วย comma เช่น http://localhost:4200,https://app.example.com
# ถ้าเว้นว่าง = ไม่อนุญาต cross-origin ใด ๆ เลย
FRONTEND_URL=http://localhost:4200

# ---- Database (MySQL 8) ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=cch_db
DB_TIMEZONE=+07:00
DB_POOL_MIN=0
DB_POOL_MAX=10
# ตั้งเป็น true เพื่อให้ log ทุก SQL ที่ยิงออกไป (ใช้ตอน debug เท่านั้น)
DB_LOGGING=false

# เปิด log ทุก request ลง terminal (method, url, status, เวลาที่ใช้, ผู้เรียก)
# ค่าเริ่มต้น: เปิดเมื่อ NODE_ENV ไม่ใช่ production
# ตั้งเป็น false เมื่อ log รกเกินไปตอนไล่ปัญหาอย่างอื่น
# หมายเหตุ: request ที่ล้มเหลวถูก log เสมอไม่ว่าค่านี้เป็นอะไร เพราะเป็นข้อมูลที่ต้องรู้
REQUEST_LOG=true

# หน้า Swagger (/api/docs) — ไม่ตั้ง = เปิดตอนพัฒนา ปิดเมื่อ NODE_ENV=production
# SWAGGER_ENABLED=false

# ---- JWT -------------------------------------------------------------------
# ใช้คนละ secret ระหว่าง access กับ refresh
# สร้าง secret ใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# จำนวนรอบ hash ของ bcrypt
BCRYPT_SALT_ROUNDS=10

# ---- บัญชี SUPER_ADMIN (ใช้ตอน npm run db:seed เท่านั้น) -------------------
# ระดับเดียวที่สร้าง/แก้/ลบ Role ได้ และ bypass permission check ทั้งหมด (BR-10)
# SUPER_ADMIN_PASSWORD ไม่มีค่า default ในโค้ด ต้องตั้งเองก่อน seed
# และต้องยาวอย่างน้อย 12 ตัวอักษร
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_FULL_NAME=ผู้ดูแลระบบ

# ---- ที่เก็บไฟล์ (Phase 9) --------------------------------------------------
# r2     เก็บบน Cloudflare R2 (ต้องใส่ค่า R2_* ข้างล่างครบ)
# local  เก็บในโฟลเดอร์ LOCAL_STORAGE_DIR บนเครื่องนี้ — ใช้ตอนพัฒนาระหว่างยังไม่มี key ของ R2
# เว้นว่าง = เลือกเอง: ใส่ key ของ R2 ครบ -> r2 / ไม่ครบและไม่ใช่ production -> local
#          production ที่ไม่มี key ของ R2 จะอัปโหลดไม่ได้ (503) ไม่แอบเก็บลงดิสก์ของเซิร์ฟเวอร์
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=uploads

# ---- Cloudflare R2 (S3-compatible) ----------------------------------------
# bucket ต้องเป็นแบบ private — ทุกการดาวน์โหลดวิ่งผ่าน API ที่ตรวจสิทธิ์ ไม่มีลิงก์สาธารณะ
# (จึงไม่มีค่า public URL — สัญญา/ใบเสนอราคาเป็นข้อมูลภายใน)
# R2_ENDPOINT มี Account ID อยู่ในตัวแล้ว คัดลอกจากหน้า R2 ของ Cloudflare ได้ตรง ๆ
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto

# ---- LINE Messaging API ----------------------------------------------------
# ยังไม่ถูกใช้ — เตรียมไว้สำหรับ Phase 11 (แจ้งเตือน)
# ใช้ส่งแจ้งเตือนให้พนักงานภายในบริษัทเท่านั้น (BR-11) ไม่ยิงหาลูกค้า
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ---- Scheduler -------------------------------------------------------------
# ยังไม่ถูกใช้ — เตรียมไว้สำหรับ Phase 11 (ยังไม่มี cron job ใดในระบบ)
# ปิด cron job ทั้งหมดตอนพัฒนาได้ด้วยการตั้งเป็น false
SCHEDULER_ENABLED=true

# ---- Business config -------------------------------------------------------
# Q2 (ตอบแล้ว 9 ก.ย. 2026): รอบโควตา MA นับจากวันเริ่มสัญญา
#   CONTRACT_ANNIVERSARY  สัญญาที่เริ่ม 15 ต.ค. ได้รอบ 15 ต.ค. - 14 พ.ย. แล้วรีเซ็ต  <- ค่าที่ใช้จริง
#   CALENDAR_MONTH        รีเซ็ตทุกวันที่ 1 ของเดือนปฏิทิน (เก็บไว้เผื่อดีลที่ตกลงกันคนละแบบ)
# ค่าที่สะกดผิดหรือไม่ได้ตั้ง จะตกไปที่ CONTRACT_ANNIVERSARY เสมอ
MA_QUOTA_RESET_MODE=CONTRACT_ANNIVERSARY
